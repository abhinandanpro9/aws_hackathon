		},
		{
			"id": "quill_http",
			"provider": "tool_http_request",
			"name": "Front desk API",
			"config": {
				"profile": "default",
				"default": {
					"allowGET": true,
					"allowPOST": true,
					"allowPUT": false,
					"allowPATCH": false,
					"allowDELETE": false,
					"allowHEAD": false,
					"allowOPTIONS": false,
					"urlWhitelist": [
						{
							"whitelistPattern": "^https://awshk-frontdesk-api\\.abhinandan-pro9\\.workers\\.dev(?:/|$)"
						}
					]
				},
				"parameters": {}
			},
			"control": [
				{
					"classType": "tool",
					"from": "quill"
				}
			],
			"ui": {
